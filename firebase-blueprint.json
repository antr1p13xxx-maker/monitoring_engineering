{
  "entities": {
    "engineering_projects": {
      "title": "Engineering Projects",
      "description": "Daftar project monitoring engineering, SPK, drawing CAD, dan checklist progres manufaktur.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik dokumen project" },
        "No": { "type": "number", "description": "Nomor urut" },
        "Bulan": { "type": "string", "description": "Bulan pengerjaan" },
        "SPK": { "type": "string", "description": "Nomor Surat Perintah Kerja" },
        "Nomor_PO": { "type": "string", "description": "Nomor Purchase Order pelanggan" },
        "Customer": { "type": "string", "description": "Nama perusahaan pelanggan" },
        "Status": { "type": "string", "description": "Status pengerjaan: Selesai, In Progress, Revisi" },
        "Delivery_Time": { "type": "string", "description": "Target tanggal delivery" },
        "Nama_Project": { "type": "string", "description": "Nama proyek mesin/jig/fixture" },
        "PIC": { "type": "string", "description": "Person In Charge engineering" },
        "Qty_Drawing": { "type": "number", "description": "Jumlah lembar gambar kerja" },
        "Permintaan_Drawing": { "type": "string", "description": "Tanggal permintaan drawing" },
        "Target_Design": { "type": "string", "description": "Target tanggal penyelesaian desain" },
        "Tanggal_Penyelesaian": { "type": "string", "description": "Aktual tanggal selesai desain" },
        "Aktual_Engineering": { "type": "string", "description": "Tanggal selesai engineering" },
        "File_CAD_Drive": { "type": "string", "description": "Link file CAD atau URL Google Drive" },
        "Konsep_3D_2D": { "type": "string", "description": "Tanggal checklist konsep 3D/2D" },
        "APPROVAL": { "type": "string", "description": "Tanggal checklist approval" },
        "Tiga_D": { "type": "string", "description": "Tanggal checklist 3D" },
        "Dua_D": { "type": "string", "description": "Tanggal checklist 2D" },
        "LIST_STANDARD_PART": { "type": "string", "description": "Tanggal checklist list standard part" },
        "list_material": { "type": "string", "description": "Tanggal checklist list material" },
        "IRD": { "type": "string", "description": "Tanggal checklist IRD" },
        "Squence": { "type": "string", "description": "Tanggal checklist sequence" },
        "animation": { "type": "string", "description": "Tanggal checklist animation" },
        "dokumentasi": { "type": "string", "description": "Tanggal checklist dokumentasi" },
        "layout_pengiriman": { "type": "string", "description": "Tanggal checklist layout pengiriman" },
        "drawing_box_pengiriman": { "type": "string", "description": "Tanggal checklist box pengiriman" },
        "simulation": { "type": "string", "description": "Tanggal checklist simulation" },
        "penawaran": { "type": "string", "description": "Tanggal penawaran" },
        "keterangan": { "type": "string", "description": "Catatan tambahan project" },
        "requiredChecklists": { "type": "array", "description": "Daftar item checklist yang diwajibkan Manager untuk project ini" },
        "updatedAt": { "type": "string", "description": "Timestamp update data" }
      },
      "required": ["SPK", "Customer", "Nama_Project"]
    },
    "kpi_records": {
      "title": "KPI Records",
      "description": "Pencatatan matriks dan evaluasi KPI bulanan engineering per tahun.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik KPI record" },
        "year": { "type": "string", "description": "Tahun evaluasi (contoh: 2026)" },
        "kpiId": { "type": "number", "description": "ID indikator KPI (1 sampai 9)" },
        "months": { "type": "string", "description": "Penyimpanan nilai bulanan Jan-Des" },
        "keterangan": { "type": "string", "description": "Keterangan capaian" },
        "updatedAt": { "type": "string", "description": "Waktu pembaruan" }
      },
      "required": ["year", "kpiId"]
    },
    "review_cost_records": {
      "title": "Review Cost Records",
      "description": "Rincian anggaran dan pengeluaran desain engineering per project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik review cost record" },
        "month": { "type": "string", "description": "Bulan evaluasi" },
        "customer": { "type": "string", "description": "Customer" },
        "projectName": { "type": "string", "description": "Nama Project" },
        "anggaran": { "type": "number", "description": "Anggaran alokasi desain" },
        "pengeluaran": { "type": "string", "description": "JSON array rincian pengeluaran" },
        "totalPengeluaran": { "type": "number", "description": "Total pengeluaran riil" },
        "efisiensi": { "type": "number", "description": "Persentase efisiensi biaya" },
        "updatedAt": { "type": "string", "description": "Timestamp update" }
      },
      "required": ["month", "customer", "projectName"]
    },
    "review_error_records": {
      "title": "Review Error Records",
      "description": "Rincian catatan kesalahan drawing teknik dan revisi dari lantai produksi.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik review error record" },
        "month": { "type": "string", "description": "Bulan evaluasi" },
        "customer": { "type": "string", "description": "Customer" },
        "projectName": { "type": "string", "description": "Nama Project" },
        "totalDrawing": { "type": "number", "description": "Total drawing" },
        "revisiCount": { "type": "number", "description": "Total revisi drawing" },
        "errorRate": { "type": "number", "description": "Tingkat error dalam %" },
        "errors": { "type": "string", "description": "JSON array rincian error part" },
        "updatedAt": { "type": "string", "description": "Timestamp update" }
      },
      "required": ["month", "customer", "projectName"]
    },
    "standart_part_handovers": {
      "title": "Serah Terima Standart Part",
      "description": "Formulir kontrol dan serah terima standart part engineering ke produksi (KMIL/FM-ENG/01-004).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik form serah terima" },
        "no": { "type": "number", "description": "Nomor urut" },
        "month": { "type": "string", "description": "Bulan evaluasi" },
        "prepareStaff": { "type": "string", "description": "JSON array nama staff prepare" },
        "projectName": { "type": "string", "description": "Nama project dari monitoring" },
        "partNames": { "type": "string", "description": "JSON array daftar nama part standard" },
        "customer": { "type": "string", "description": "Nama customer" },
        "distributionDate": { "type": "string", "description": "Tanggal distribusi" },
        "distributionTime": { "type": "string", "description": "Waktu distribusi" },
        "division": { "type": "string", "description": "Divisi penerima" },
        "signature": { "type": "string", "description": "Tanda tangan atau status penyerahan" },
        "spk": { "type": "string", "description": "Nomor SPK terkait" },
        "notes": { "type": "string", "description": "Catatan tambahan" },
        "updatedAt": { "type": "string", "description": "Timestamp update" }
      },
      "required": ["month", "projectName", "customer"]
    },
    "design_feedback_records": {
      "title": "Design Quality Feedback Records",
      "description": "Catatan feedback tim produksi dan tim kastamer untuk perhitungan KPI Design Quality.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik feedback record" },
        "month": { "type": "string", "description": "Bulan evaluasi" },
        "customer": { "type": "string", "description": "Nama customer" },
        "projectName": { "type": "string", "description": "Nama project" },
        "fbProduksi": { "type": "string", "description": "Feedback dari team produksi" },
        "fbKastamer": { "type": "string", "description": "Feedback dari team kastamer" },
        "isNoRevision": { "type": "boolean", "description": "True jika tidak ada catatan feedback revisi" },
        "updatedAt": { "type": "string", "description": "Timestamp update" }
      },
      "required": ["month", "customer", "projectName"]
    },
    "kpi_approval_requests": {
      "title": "KPI Approval Requests",
      "description": "Antrean pengajuan input/perubahan data Dashboard KPI CDR dari Supervisor yang memerlukan persetujuan Manager.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik pengajuan" },
        "category": { "type": "string", "description": "Kategori perubahan KPI" },
        "categoryLabel": { "type": "string", "description": "Label kategori" },
        "targetLabel": { "type": "string", "description": "Target project/bulan/indikator" },
        "summaryOld": { "type": "string", "description": "Ringkasan nilai sebelum perubahan" },
        "summaryNew": { "type": "string", "description": "Ringkasan nilai yang diajukan" },
        "requestedBy": { "type": "string", "description": "Role pengaju" },
        "requestedAt": { "type": "string", "description": "Waktu pengajuan" },
        "status": { "type": "string", "description": "pending, approved, atau rejected" },
        "reviewedBy": { "type": "string", "description": "Role pemeriksa (Manager)" },
        "reviewedAt": { "type": "string", "description": "Waktu persetujuan/penolakan" },
        "reviewNote": { "type": "string", "description": "Catatan persetujuan/penolakan" },
        "payload": { "type": "string", "description": "JSON payload detail perubahan" },
        "updatedAt": { "type": "string", "description": "Timestamp update" }
      },
      "required": ["id", "category", "status", "requestedBy"]
    },
    "active_sessions": {
      "title": "Active Sessions Presence",
      "description": "Status real-time staff yang sedang online, login, dan mengedit data.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "ID unik sesi browser/perangkat" },
        "staffId": { "type": "string", "description": "ID akun staff atau viewer" },
        "staffName": { "type": "string", "description": "Nama staff yang sedang login" },
        "role": { "type": "string", "description": "Role akses pengguna" },
        "status": { "type": "string", "description": "online atau editing" },
        "currentView": { "type": "string", "description": "Halaman yang sedang dibuka" },
        "editingTarget": { "type": "string", "description": "Item/SPK yang sedang diedit" },
        "deviceLabel": { "type": "string", "description": "Perangkat (HP/Mobile atau Desktop PC)" },
        "loggedInAt": { "type": "string", "description": "Waktu mulai login/sesi" },
        "lastHeartbeat": { "type": "string", "description": "Waktu detak aktivitas terakhir" }
      },
      "required": ["sessionId", "staffName", "role", "status", "lastHeartbeat"]
    },
    "team_chat_messages": {
      "title": "Team Chat Messages",
      "description": "Pesan obrolan real-time antar user dan staff yang sedang online di aplikasi.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik pesan chat" },
        "roomId": { "type": "string", "description": "ID room chat (global atau dm__idA__idB)" },
        "senderSessionId": { "type": "string", "description": "Session ID pengirim" },
        "senderStaffId": { "type": "string", "description": "Staff ID pengirim atau viewer" },
        "senderName": { "type": "string", "description": "Nama pengirim" },
        "senderRole": { "type": "string", "description": "Role pengirim" },
        "recipientKey": { "type": "string", "description": "Kunci identitas penerima untuk DM" },
        "recipientName": { "type": "string", "description": "Nama penerima untuk DM" },
        "text": { "type": "string", "description": "Isi pesan chat" },
        "relatedSpk": { "type": "string", "description": "Nomor SPK proyek yang ditautkan (opsional)" },
        "replyToId": { "type": "string", "description": "ID pesan yang dibalas" },
        "replyToSender": { "type": "string", "description": "Nama pengirim pesan yang dibalas" },
        "replyToPreview": { "type": "string", "description": "Cuplikan pesan yang dibalas" },
        "createdAt": { "type": "string", "description": "Timestamp ISO waktu pengiriman pesan" }
      },
      "required": ["id", "roomId", "senderSessionId", "senderStaffId", "senderName", "senderRole", "text", "createdAt"]
    }
  },
  "firestore": {
    "/engineering_projects/{projectId}": {
      "schema": "#/entities/engineering_projects",
      "description": "Dokumen database project monitoring engineering terpusat."
    },
    "/kpi_records/{recordId}": {
      "schema": "#/entities/kpi_records",
      "description": "Dokumen evaluasi capaian KPI bulanan engineering."
    },
    "/review_cost_records/{recordId}": {
      "schema": "#/entities/review_cost_records",
      "description": "Dokumen evaluasi biaya dan efisiensi desain."
    },
    "/review_error_records/{recordId}": {
      "schema": "#/entities/review_error_records",
      "description": "Dokumen pencatatan drawing error dan revisi desain."
    },
    "/standart_part_handovers/{handoverId}": {
      "schema": "#/entities/standart_part_handovers",
      "description": "Dokumen kontrol serah terima standart part (KMIL/FM-ENG/01-004)."
    },
    "/design_feedback_records/{recordId}": {
      "schema": "#/entities/design_feedback_records",
      "description": "Dokumen pencatatan feedback tim produksi & kastamer untuk KPI Design Quality."
    },
    "/kpi_approval_requests/{requestId}": {
      "schema": "#/entities/kpi_approval_requests",
      "description": "Dokumen antrean persetujuan Manager untuk pengajuan input data KPI oleh Supervisor."
    },
    "/active_sessions/{sessionId}": {
      "schema": "#/entities/active_sessions",
      "description": "Status kehadiran real-time staff yang sedang online, login, dan mengedit data."
    },
    "/team_chat_messages/{messageId}": {
      "schema": "#/entities/team_chat_messages",
      "description": "Pesan obrolan real-time antar pengguna yang sedang online."
    }
  }
}
