rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Engineering Projects Collection
    match /engineering_projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isValidId(projectId);
    }

    // KPI Records Collection
    match /kpi_records/{recordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    // Review Cost Records Collection
    match /review_cost_records/{recordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    // Review Error Records Collection
    match /review_error_records/{recordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    // Serah Terima Standart Part Collection
    match /standart_part_handovers/{handoverId} {
      allow read: if true;
      allow create, update, delete: if isValidId(handoverId);
    }

    // Design Quality Feedback Records Collection
    match /design_feedback_records/{recordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    // KPI Supervisor Approval Requests Collection
    match /kpi_approval_requests/{requestId} {
      allow read: if true;
      allow create, update, delete: if isValidId(requestId);
    }

    // Staff Accounts & Individual PIN Management Collection
    match /staff_accounts/{staffId} {
      allow read: if true;
      allow create, update, delete: if isValidId(staffId);
    }

    // Global Activity Audit Trail Collection
    match /activity_audit_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if isValidId(logId);
    }

    // Real-Time Active Staff Presence & Editing Tracking Collection
    match /active_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(sessionId);
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Fallback default deny for any undefined paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
